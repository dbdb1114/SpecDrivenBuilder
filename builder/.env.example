# LLM 을 무엇으로 호출할지. claude-cli(기본, `claude -p` — 로그인된 요금제 안에서 돈다) 또는 anthropic-api(Claude API — 호출마다 과금).
SPECBUILDER_LLM=claude-cli
# anthropic-api 일 때 필요한 키. 실제 키는 .env 에만 적는다 (.env 는 커밋되지 않는다).
ANTHROPIC_API_KEY=
# 호출에 쓸 모델 ID. 비우면 claude-sonnet-5-5.
SPECBUILDER_MODEL=claude-sonnet-5-5
# 사용자 프로필 저장 파일. 비우면 ~/.specbuilder/profile.json. 지우면 다음 실행에서 프로필을 다시 묻는다.
SPECBUILDER_PROFILE_PATH=
